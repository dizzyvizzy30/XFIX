# Fetch.ai: ASI:One key from https://asi1.ai/developer
ASI1_API_KEY=your-asi1-api-key
AGENT_NAME=your-unique-agent-name
AGENT_SEED=your-unique-secret-seed-phrase
AGENTVERSE_KEY=your-agentverse-key

# Meta Model API key from https://dev.meta.ai
META_API_KEY=your-meta-api-key

# Subquadratic key from https://console.subq.ai
SUBQ_API_KEY=your-subq-api-key

# MongoDB Atlas connection string
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/
